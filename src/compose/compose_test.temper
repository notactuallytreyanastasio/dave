// Tests for the compose module, ported from notedance_viewer's
// test/dave/compose_test.exs: the assertions about turns, parsing, the
// effort schedule, the draft and giving up. The ones about Ecto and the
// channel are the host's. The scripted GLM there is a named Agent; here it
// is a list the test walks while it drives the step machine. The host's
// reader (Dave.Compose.Text.parse) is stood in for by a bar counter that
// says what Jam Pilot's reader says about a bar that does not add up, and
// the word list (Dave.Compose.Suitable) by one word.
//
// No std import here: the module's library files already bind what the
// tests use (see probes/js-test-std-import).

let song = "title: Hot Cross Buns\ntempo: 90\n[Xylophone]\nE5 D C/2 | E D C/2 | C C C C | D D D D | E D C/2\n";
let example = "title: Twinkle Twinkle Little Star\n[Xylophone]\nC C G G | A A G/2\n";
let systemPrompt = "You write songs for Jam Pilot. THE FORMAT: title: Twinkle Twinkle Little Star ... Reply with one line starting \"Summary:\" and the song in a ``` fence.";

let reply(text: String, summary: String): String { "Summary: ${summary}\n```\n${text}```\n" }
let wrote(text: String): String { reply(text, "Wrote Hot Cross Buns for xylophone.") }

// A scripted reply: a completion text, a cut-off, or a transport failure.
sealed interface Canned {}
class Reply(public text: String) extends Canned {}
class Truncated(public reasoningTokens: Int) extends Canned {}
class Offline(public why: String, public kind: String) extends Canned {}

// Drive the agent to its end. Every request the model would have seen is
// kept in `requests`, in order; every refusal the host made in `refusals`.
class ComposeRun(public setup: ComposeSetup, public script: List<Canned>) {
  public agent: ComposeAgent = new ComposeAgent(setup);
  public requests: ListBuilder<ChatRequest> = new ListBuilder<ChatRequest>();
  public refusals: ListBuilder<List<String>> = new ListBuilder<List<String>>();
  public var outcome: ComposeOutcome? = null;

  // Methods, not top-level functions: see the note in repair_test.temper
  // about the C# backend's test class.

  private has(text: String, needle: String): Boolean { text.indexOf(needle, String.begin) is StringIndex }

  // Jam Pilot's reader, as far as these songs need it: in 4/4 a bar adds up
  // to 4 beats; a note is a quarter, /2 a half, /8 an eighth, /1 a whole.
  // The first and last bar of a part may be short (a pickup, an ending),
  // as the real reader allows.
  public reader(text: String): List<String> {
    let out = new ListBuilder<String>();
    var part = "";
    for (let line of text.split("\n")) {
      if (has(line, "[")) {
        let open = line.indexOf("[", String.begin);
        let close = line.indexOf("]", String.begin);
        when (open) {
          is StringIndex -> when (close) {
            is StringIndex -> do { part = line.slice(line.next(open), close); };
            else -> do { part = line; };
          };
          else -> do { part = line; };
        }
      } else if (has(line, "|")) {
        let bars = line.split("|");
        var k = 0;
        while (k < bars.length) {
          var eighths = 0;
          for (let token of bars[k].split(" ")) {
            if (!token.isEmpty) {
              eighths += if (has(token, "/2")) { 4 } else if (has(token, "/8")) { 1 } else if (has(token, "/1")) { 8 } else { 2 };
            }
          }
          let n = k + 1;
          if (eighths != 8 && n != 1 && n != bars.length) {
            let beats = if (eighths % 2 == 0) { (eighths / 2).toString() } else { "${eighths / 2}.5" };
            out.add("${part}, bar ${n} adds up to ${beats} beats; 4/4 wants 4.");
          }
          k += 1;
        }
      }
    }
    out.toList()
  }

  // Dave.Compose.Suitable, with one word.
  public unsuitable(text: String): Boolean { has(text, "Damn") || has(text, "damn") }

  public completion(text: String?, finish: String, reasoning: Int?): ChatResponse {
    new ChatResponse("r", "m", [new Choice(0, new AssistantMessage(text), finish)], null,
      new Usage(10, 20, 30, reasoning))
  }

  public go(): Void {
    var step = agent.next(new Start());
    var replies = 0;
    var running = true;
    while (running) {
      let current = step;
      when (current) {
        is SendRequest -> do {
          requests.add(current.request);
          if (replies >= script.length) {
            step = agent.next(new TransportFailed("scripted model ran out of replies", TransportFailures.sentence));
          } else {
            let next = script[replies];
            replies += 1;
            step = when (next) {
              is Reply -> agent.next(new Responded(completion(next.text, FinishReasons.stop, 100)));
              is Truncated -> agent.next(new Responded(completion(null, FinishReasons.length, next.reasoningTokens)));
              is Offline -> agent.next(new TransportFailed(next.why, next.kind));
            };
          }
        };
        is Check -> do {
          // the host: the reader first, then the word list, on the song and the summary
          let c = current.candidate;
          var problems = reader(c.text);
          let rude = unsuitable("${c.text}\n${c.summary}");
          if (problems.isEmpty && rude) {
            problems = ["The song is for young children and cannot contain “damn”. Rewrite it on a cheerful, safe subject with none of those words anywhere, not in the title, the words, the part names or the summary."];
          }
          if (problems.isEmpty) {
            step = agent.next(new CheckPassed());
          } else {
            refusals.add(problems);
            step = agent.next(new CheckRefused(problems, !rude));
          }
        };
        is Done -> do { outcome = agent.outcome(current); running = false; };
        is GaveUp -> do { outcome = agent.outcome(current); running = false; };
      }
    }
  }
}

let runWith(script: List<Canned>, text: String, request: String, rounds: Int): ComposeRun {
  let setup: ComposeSetup = { class: ComposeSetup, song: text, request: request, systemPrompt: systemPrompt,
    model: "glm-5.3", rounds: rounds };
  let run = new ComposeRun(setup, script);
  run.go();
  run
}

let roleList(request: ChatRequest): String {
  request.messages.map { (m): String => m.role }.join(" ") { it => it }
}

let textOf(m: Message): String {
  when (m) {
    is UserMessage -> m.text ?? "";
    is SystemMessage -> m.content;
    is AssistantMessage -> m.content ?? "";
    is ToolMessage -> m.content;
  }
}

let lastUser(request: ChatRequest): String { textOf(request.messages[request.messages.length - 1]) }

let effortOf(request: ChatRequest): String {
  let v = request.extra.getOr("reasoning_effort", new JsonNull());
  when (v) {
    is JsonString -> v.content;
    else -> "(none)";
  }
}

let songOf(outcome: ComposeOutcome?): SongWritten? {
  when (outcome) {
    is SongWritten -> outcome;
    else -> null;
  }
}

let sentenceOf(outcome: ComposeOutcome?): String {
  when (outcome) {
    is NoSong -> outcome.sentence;
    is SongWritten -> "(a song: ${outcome.summary})";
    else -> "(no outcome)";
  }
}

// ---------- assist ----------

let runFirstReply(test: Test): Void {
  let run = runWith([new Reply(wrote(song))], example, "hot cross buns please", 5);
  let got = songOf(run.outcome);
  assert(got != null) { sentenceOf(run.outcome) }
  if (got != null) {
    assert(got.text == song) { got.text }
    assert(got.summary == "Wrote Hot Cross Buns for xylophone.") { got.summary }
    assert(got.problems.isEmpty);
  }
  assert(run.requests.length == 1);
  let first = run.requests[0];
  assert(roleList(first) == "system user") { roleList(first) }
  assert(textOf(first.messages[0]) == systemPrompt);
  let user = lastUser(first);
  assert(contains(user, "<<<REQUEST\nhot cross buns please\nREQUEST>>>")) { user }
  assert(contains(user, trim(example))) { user }
  // the opening turn, byte for byte as compose.ex's user_turn/2 heredoc
  assert(user == "The song as it stands, between the markers (it may be a starting example\nthe teacher has not touched, or empty):\n\n<<<SONG\n${trim(example)}\nSONG>>>\n\nThe teacher asks, between the markers:\n\n<<<REQUEST\nhot cross buns please\nREQUEST>>>\n") { user }
  assert(effortOf(first) == "low") { effortOf(first) }
  assert(first.maxTokens == 24000);
  assert(first.temperature == 0.2);
  assert(first.model == "glm-5.3");
}
test("the bot's song is read and handed back with its summary") { test => runFirstReply(test); }

let bad = "title: Hot Cross Buns\ntempo: 90\n[Xylophone]\nE5 D C/2 | E D C/2 | C C C | D D D D | E D C/2\n";

let runOnceMore(test: Test): Void {
  let run = runWith([new Reply(wrote(bad)), new Reply(reply(song, "Fixed bar 3."))], "", "hot cross buns", 5);
  let got = songOf(run.outcome);
  assert(got != null && got.summary == "Fixed bar 3.") { sentenceOf(run.outcome) }
  assert(run.requests.length == 2);
  let second = run.requests[1];
  assert(roleList(second) == "system user assistant user") { roleList(second) }
  assert(textOf(second.messages[2]) == wrote(bad));
  let fix = lastUser(second);
  assert(contains(fix, "- Xylophone, bar 3 adds up to 3 beats; 4/4 wants 4.")) { fix }
  // the fix turn, byte for byte as compose.ex's fix_turn/1 heredoc
  assert(fix == "Jam Pilot could not read that song:\n\n- Xylophone, bar 3 adds up to 3 beats; 4/4 wants 4.\n\nA rest inside a bar is r with a length (r, r/2, r/8); - on its own is a\nwhole bar of rest and cannot sit beside notes. The words of a part have one\nsyllable per note, and _ fills a note that has no word.\n\nA bar with too many beats has notes that are too long for it: halve them\n(/1 to /2, /2 to /4, /4 to /8) or move the extra notes into a bar of their\nown, keeping every part the same number of bars. Check every bar of every\npart, not only the ones named, then send the whole corrected song again\nthe same way: a Summary: line and the complete song in a ``` fence.\n") { fix }
  assert(run.refusals.length == 1 && run.refusals[0].length == 1);
  // the attempts: one refused, one that passed
  let attempts = run.agent.attemptsSoFar;
  assert(attempts.length == 2) { "attempts ${attempts.length}" }
  assert(attempts[0].round == 1 && attempts[0].summary == "Wrote Hot Cross Buns for xylophone." && attempts[0].error == "Xylophone, bar 3 adds up to 3 beats; 4/4 wants 4.") { attempts[0].error ?? "" }
  assert(attempts[1].round == 2 && attempts[1].error == null && attempts[1].edits.isEmpty);
}
test("a song that does not add up goes back to the model with the reader's sentences, once") { test => runOnceMore(test); }

let runRoundsOut(test: Test): Void {
  let run = runWith([new Reply(wrote(bad)), new Reply(reply(bad, "Second go."))], "", "x", 2);
  let got = songOf(run.outcome);
  assert(got != null) { sentenceOf(run.outcome) }
  if (got != null) {
    assert(got.text == bad) { got.text }
    assert(got.summary == "Second go. After 2 tries the reader still found 1 thing to fix, listed under the song: fix them by hand, or ask the bot again.") { got.summary }
    assert(got.problems.length == 1 && contains(got.problems[0], "bar 3")) { got.problems.join("|") { it => it } }
  }
  // the second round is given more room to think
  assert(effortOf(run.requests[0]) == "low" && effortOf(run.requests[1]) == "medium") { "${effortOf(run.requests[0])} ${effortOf(run.requests[1])}" }
  assert(run.requests.length == 2);
}
test("when the rounds run out the last draft comes back with its problems, not nothing") { test => runRoundsOut(test); }

// Two problems on the draft: "things", not "thing".
let runRoundsOutPlural(test: Test): Void {
  let twoBad = "title: X\n[Xylophone]\nC C C C | C C C | C C C | C C C C\n";
  let run = runWith([new Reply(reply(twoBad, "Go."))], "", "x", 1);
  let got = songOf(run.outcome);
  assert(got != null) { sentenceOf(run.outcome) }
  if (got != null) {
    assert(got.summary == "Go. After 1 tries the reader still found 2 things to fix, listed under the song: fix them by hand, or ask the bot again.") { got.summary }
    assert(got.problems.length == 2);
  }
}
test("two things to fix are plural in the give-up summary") { test => runRoundsOutPlural(test); }

let runNeverASong(test: Test): Void {
  let run = runWith([new Reply("no song here"), new Reply("still none")], "", "x", 2);
  let sentence = sentenceOf(run.outcome);
  assert(run.outcome is NoSong) { sentence }
  assert(contains(sentence, "still did not read after 2 tries")) { sentence }
  assert(sentence == "The bot's song still did not read after 2 tries. ${noScore}") { sentence }
  // the parse failure is the model's next turn and the attempt's record
  assert(contains(lastUser(run.requests[1]), "- ${noScore}")) { lastUser(run.requests[1]) }
  assert(run.agent.attemptsSoFar[0].error == noScore);
  assert(run.refusals.isEmpty);
}
test("replies that were never a song leave nothing to hand back") { test => runNeverASong(test); }

let runManyProblems(test: Test): Void {
  let bars = new ListBuilder<String>();
  var i = 0;
  while (i < 25) { bars.add("C5 D E"); i += 1; }
  let many = "title: Hot Cross Buns\ntempo: 90\n[Xylophone]\n${bars.join(" | ") { it => it }}\n";
  let run = runWith([new Reply(wrote(many)), new Reply(wrote(song))], "", "x", 5);
  assert(songOf(run.outcome) != null) { sentenceOf(run.outcome) }
  let fix = lastUser(run.requests[1]);
  // bars 2 to 24 are wrong (the first and last may be short): 23 problems
  assert(run.refusals[0].length == 23) { "${run.refusals[0].length}" }
  assert(contains(fix, "- Xylophone, bar 21 adds up to 3 beats")) { fix }
  assert(!contains(fix, "bar 22 adds up")) { fix }
  assert(contains(fix, "- ...and 3 more like these.\n\nA rest inside a bar")) { fix }
}
test("a long list of problems is cut to twenty for the model, with the count") { test => runManyProblems(test); }

let runNoFence(test: Test): Void {
  let run = runWith([new Reply("Here is a song: C D E F"), new Reply(wrote(song))], "", "x", 5);
  assert(songOf(run.outcome) != null) { sentenceOf(run.outcome) }
  assert(contains(lastUser(run.requests[1]), "has no score")) { lastUser(run.requests[1]) }
}
test("a reply with no fence is sent back for one more try") { test => runNoFence(test); }

let runEmptyFence(test: Test): Void {
  let run = runWith([new Reply("Summary: s\n```\n\n```\n"), new Reply(wrote(song))], "", "x", 5);
  assert(songOf(run.outcome) != null) { sentenceOf(run.outcome) }
  assert(contains(lastUser(run.requests[1]), "- ${emptyFence}")) { lastUser(run.requests[1]) }
}
test("an empty fence is sent back with its own sentence") { test => runEmptyFence(test); }

let rude = "title: Damn Buns\ntempo: 90\n[Xylophone]\nE5 D C/2 | E D C/2 | C C C C | D D D D | E D C/2\n";

let runUnsuitable(test: Test): Void {
  let run = runWith([new Reply(wrote(rude)), new Reply(reply(song, "Kept it suitable."))], "", "x", 5);
  let got = songOf(run.outcome);
  assert(got != null && got.summary == "Kept it suitable.") { sentenceOf(run.outcome) }
  assert(contains(lastUser(run.requests[1]), "cannot contain “damn”")) { lastUser(run.requests[1]) }

  let refused = runWith([new Reply(wrote(rude)), new Reply(wrote(rude)), new Reply(wrote(rude))], "", "x", 3);
  let sentence = sentenceOf(refused.outcome);
  assert(refused.outcome is NoSong) { sentence }
  assert(sentence == "The bot kept writing words that are not suitable for children, so nothing was changed. Try asking for the song another way.") { sentence }
  assert(!contains(sentence, "damn"));
  // a song that read but is unfit for children is never the draft
  assert(refused.agent.draft == null) { "a rude song was kept as the draft" }
}
test("a song with a word unfit for children goes back to the model, and the teacher never sees the word") { test => runUnsuitable(test); }

// The draft is the last song that read as one and was fit: a rude round
// after a good-but-wrong one does not replace it, and the draft keeps its
// own problems, not the last round's.
let runDraftKept(test: Test): Void {
  let run = runWith([new Reply(reply(bad, "First go.")), new Reply(wrote(rude)), new Reply("nothing")], "", "x", 3);
  let got = songOf(run.outcome);
  assert(got != null) { sentenceOf(run.outcome) }
  if (got != null) {
    assert(got.text == bad);
    assert(contains(got.summary, "First go. After 3 tries the reader still found 1 thing to fix")) { got.summary }
    assert(got.problems.length == 1 && contains(got.problems[0], "bar 3")) { got.problems.join("|") { it => it } }
  }
}
test("the draft is the last song that read and was fit, with its own problems") { test => runDraftKept(test); }

let runNoKey(test: Test): Void {
  let run = runWith([new Offline("no GLM_API_KEY configured", TransportFailures.noKey)], "", "x", 5);
  assert(sentenceOf(run.outcome) == "The bot is not set up on this server (no GLM_API_KEY).") { sentenceOf(run.outcome) }
  assert(run.requests.length == 1);
  let failed = runWith([new Offline("GLM answered 503: busy", TransportFailures.sentence)], "", "x", 5);
  assert(sentenceOf(failed.outcome) == "GLM answered 503: busy") { sentenceOf(failed.outcome) }
  let odd = runWith([new Offline("{:closed, :timeout}", TransportFailures.detail)], "", "x", 5);
  assert(sentenceOf(odd.outcome) == "The bot did not answer: {:closed, :timeout}") { sentenceOf(odd.outcome) }
}
test("without a key the teacher is told; a transport sentence is passed on; a raw detail is wrapped") { test => runNoKey(test); }

let runCutOff(test: Test): Void {
  let run = runWith([new Truncated(23900), new Reply(wrote(song))], "", "x", 5);
  let sentence = sentenceOf(run.outcome);
  assert(run.outcome is NoSong) { sentence }
  assert(sentence == "GLM ran out of room: 23900 of 24000 tokens went to thinking and the reply was cut off before any answer") { sentence }
  // no retry: the second canned reply was never asked for
  assert(run.requests.length == 1) { "requests ${run.requests.length}" }
  assert(run.agent.attemptsSoFar.length == 1 && run.agent.attemptsSoFar[0].error == sentence);
}
test("a reply cut off at max_tokens ends the loop with its sentence, no retry") { test => runCutOff(test); }

// ---------- parse_reply ----------

let parsed(reply: String): String {
  let problems = new Problems();
  let p: Proposal? = parseReply(reply, problems) orelse null;
  if (p == null) { "ERROR ${problems.last ?? ""}" } else { "${p.summary}|${p.text ?? ""}" }
}

// The cases go through a list the test walks: a call like
// parsed("literal") is folded by the frontend's own interpreter at compile
// time (see temper-testing), and its interpreter bubbled on this scanner
// where every backend's translation reads it fine.
let parseCases: List<List<String>> = [
  // a fence with a language, and the summary line after it
  ["```text\ntitle: A\n[A]\nC5/1\n```\nSummary: s", "s|title: A\n[A]\nC5/1\n"],
  ["no fence here", "ERROR ${noScore}"],
  ["Summary: s\n```\n\n```\n", "ERROR ${emptyFence}"],
  // no language, the song's own trailing newline is normalised to one
  [wrote(song), "Wrote Hot Cross Buns for xylophone.|${song}"],
  ["Summary: s\n```\ntitle: A\n[A]\nC5/1```", "s|title: A\n[A]\nC5/1\n"],
  ["Summary: s\n```\ntitle: A\n\n\n```", "s|title: A\n"],
  // CRLF, spaces after the language, the summary in any case with blanks around it
  ["  SUMMARY:   S  \r\n```abc \t\r\ntitle: A\r\n[A]\r\nC5/1\r\n```\r\n", "S|title: A\r\n[A]\r\nC5/1\n"],
  // a ``` inline in prose is not the fence; "Summary:" not at a line start is not the summary
  ["Use ``` fences. Not a Summary: here\n```\ntitle: A\n```\nSummary: real", "real|title: A\n"],
  // no summary line at all is ""
  ["```\ntitle: A\n```", "|title: A\n"],
  // \s* after the colon crosses a line break, as the PCRE did
  ["Summary:\nnext line\n```\ntitle: A\n```", "next line|title: A\n"],
  // "Summary:" with only blanks to the end captures its last blank, as the PCRE did
  ["```\ntitle: A\n```\nSummary: \n", " |title: A\n"],
  // a language that is not letters is no fence head
  ["```c++\ntitle: A\n```", "ERROR ${noScore}"],
];

let runParseReply(test: Test): Void {
  var n = 0;
  for (let c of parseCases) {
    let got = parsed(c[0]);
    assert(got == c[1]) { "case ${n}: want `${c[1]}` got `${got}`" }
    n += 1;
  }
  // String.trim strips a no-break space too
  assert(trim("\u{a0} x \u{a0}") == "x") { trim("\u{a0} x \u{a0}") }
  assert(trim("") == "" && trim("  ") == "");
}
test("parse_reply takes a fence with or without a language, and the summary line anywhere") { test => runParseReply(test); }

let runFixTurnCap(test: Test): Void {
  let one = fixTurn(["a"]);
  assert(contains(one, "song:\n\n- a\n\nA rest")) { one }
  let none = fixTurn([]);
  assert(contains(none, "song:\n\n\n\nA rest")) { none }
  let ps = new ListBuilder<String>();
  var i = 1;
  while (i <= 21) { ps.add("p${i}"); i += 1; }
  let capped = fixTurn(ps.toList());
  assert(contains(capped, "- p20\n- ...and 1 more like these.\n\n")) { capped }
  assert(!contains(capped, "p21"));
}
test("fix_turn lists at most twenty problems and counts the rest") { test => runFixTurnCap(test); }

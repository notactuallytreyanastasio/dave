# Deciduous: local database stays private, the shared graph is tracked
.deciduous/*
!.deciduous/config.toml
!.deciduous/graph.json

# Temper build output; regenerated by `bin/temper build`, never edited.
temper.out/
temper.keep/
build/

# Model keys for live probes; never committed.
.env

# Elixir and Node build output under probes and hosts
_build/
deps/
node_modules/
